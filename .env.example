# Gmail SMTP Configuration
# ========================
# To use Gmail SMTP, you need to create an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification (if not already enabled)
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create a new App Password for "Mail" on "Other (Custom name)"
# 5. Copy the 16-character password below

GMAIL_ADDRESS=coreyely1@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Recipient (defaults to GMAIL_ADDRESS if not set)
RECIPIENT_EMAIL=coreyely1@gmail.com

# Timezone for scheduling (default: America/New_York)
TIMEZONE=America/New_York

# JSearch API (RapidAPI) for Job Alerts
# =====================================
# 1. Sign up at https://rapidapi.com
# 2. Subscribe to JSearch API: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# 3. Copy your RapidAPI key below
RAPIDAPI_KEY=your-rapidapi-key-here
